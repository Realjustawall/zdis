# ---------------------------------------------------------------------------
# youtBeLimo configuration. Copy to .env and adjust. Every value has a working
# default, so an empty .env still boots.
# ---------------------------------------------------------------------------

APP_NAME=youtBeLimo
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Externally reachable server origin, used to build SSO callback URLs.
# PUBLIC_URL=https://chat.example.com
# DEPLOYMENT_REGION=local
# DEPLOYMENT_ROLE=primary
# ALLOW_WRITES=true

# Origin(s) allowed to call the API with cookies. Comma-separated.
# In development this is the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# --------------------------------------------------------------- persistence
# Leave DATABASE_URL empty to use the SQLite engine built into Node (no
# installation, no native compilation). Set it to a reachable PostgreSQL and
# the app uses that instead; if the connection fails it falls back to SQLite.
# DATABASE_URL=postgres://user:password@localhost:5432/youtbelimo
# Optional read-only endpoint used by search/reporting. It falls back to the
# primary unless REQUIRE_READ_REPLICA is enabled.
# READ_DATABASE_URL=postgres://reader:password@replica:5432/youtbelimo
# REQUIRE_READ_REPLICA=false
# Fail startup instead of falling back when the enterprise dependency is down.
# REQUIRE_POSTGRES=true

# Optional. When set and reachable, Redis backs the cache and the Socket.IO
# adapter (needed if you run more than one server process). Otherwise an
# in-process cache is used automatically.
# REDIS_URL=redis://localhost:6379
# For Redis Cluster, omit REDIS_URL and list seed nodes:
# REDIS_CLUSTER_NODES=redis-0:6379,redis-1:6379,redis-2:6379
# REQUIRE_REDIS=true

# Where the SQLite file and uploaded files live.
# DATA_DIR=./server/data

# ------------------------------------------------------------------ security
# 32+ characters. Generated and stored in DATA_DIR/.app_secret if omitted.
# Changing it invalidates every session and CSRF token.
# APP_SECRET=
# During rotation, put the former key(s) here until the longest session TTL
# passes. New CSRF tokens use APP_SECRET; old sessions remain valid temporarily.
# APP_SECRET_PREVIOUS=
# Keep this stable to verify the tamper-evident audit chain across deployments.
# Prefer a mounted secret in production.
# AUDIT_SIGNING_KEY=
# AUDIT_SIGNING_KEY_FILE=/run/secrets/audit_signing_key
# Recovery codes have their own rotatable signing key.
# RECOVERY_CODE_SIGNING_KEY_FILE=/run/secrets/recovery_code_signing_key
# RECOVERY_CODE_PREVIOUS_KEYS=

# Send cookies only over HTTPS. Turn this on in production.
SECURE_COOKIES=false

# Turn on when running behind nginx/Caddy so the real client IP is used for
# rate limiting and the audit log.
TRUST_PROXY=false

SESSION_TTL_HOURS=336
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
# Data-loss prevention for messages and text/JSON uploads: off | audit | block.
# DLP_MODE=block

# Optional distributed message search. Use HTTPS and credentials for managed/
# production clusters; the Compose example uses an isolated local HTTP node.
# OPENSEARCH_URL=https://search.example.com
# OPENSEARCH_USERNAME=youtbelimo
# OPENSEARCH_PASSWORD=
# OPENSEARCH_PASSWORD_FILE=
# OPENSEARCH_INDEX=youtbelimo-messages-v1
# OPENSEARCH_TIMEOUT_MS=5000
# OPENSEARCH_REQUIRED=false

# --------------------------------------------------------- enterprise identity
# OIDC / OAuth 2.0 Authorization Code + PKCE (Entra ID, Okta, Keycloak,
# Auth0, Google Workspace, etc.).
# OIDC_ISSUER=https://id.example.com/realms/company
# OIDC_CLIENT_ID=youtbelimo
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_LABEL=Company SSO
# OIDC_SCOPES=openid profile email
# OIDC_AUTO_PROVISION=false
# OIDC_ALLOWED_DOMAINS=example.com

# Native SAML 2.0. Signed responses and assertions are mandatory.
# SAML_ENTRY_POINT=https://id.example.com/saml/login
# SAML_SP_ISSUER=https://chat.example.com/saml/metadata
# SAML_IDP_ISSUER=https://id.example.com/
# SAML_IDP_CERT_FILE=/run/secrets/saml-idp-cert.pem
# SAML_SP_PRIVATE_KEY_FILE=/run/secrets/saml-sp-key.pem
# SAML_SP_PUBLIC_CERT_FILE=/run/secrets/saml-sp-cert.pem
# SAML_LABEL=SAML SSO
# SAML_AUTO_PROVISION=false
# SAML_ALLOWED_DOMAINS=example.com

# LDAP/Active Directory search + user bind. LDAPS is required by default.
# LDAP_URL=ldaps://directory.example.com:636
# LDAP_BIND_DN=cn=chat-reader,ou=service,dc=example,dc=com
# LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password
# LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_SEARCH_FILTER=(&(objectClass=person)(|(mail={{username}})(uid={{username}})(sAMAccountName={{username}})))
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# LDAP_USERNAME_ATTRIBUTE=uid
# LDAP_CA_FILE=/run/secrets/ldap-ca.pem
# LDAP_AUTO_PROVISION=false
# LDAP_ALLOWED_DOMAINS=example.com

# Hard ceiling for uploads. The admin panel can lower it, never raise it.
MAX_UPLOAD_MB=100
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2-pro
FISH_AUDIO_REFERENCE_ID=
USER_STORAGE_QUOTA_GB=10
RESUMABLE_CHUNK_MB=5
UPLOAD_RETENTION_DAYS=365
ANTIVIRUS_RESCAN_DAYS=7

# Enterprise object storage. MinIO and other S3-compatible services work too.
# STORAGE_DRIVER=s3
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.example.com
# Browser-visible endpoint for presigned URLs when S3_ENDPOINT is an internal
# service address (for example http://localhost:9000 for local MinIO).
# S3_PUBLIC_ENDPOINT=
# S3_BUCKET=youtbelimo-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Optional: AES256 for S3-managed encryption. Leave empty for MinIO without KMS.
# Supplying S3_KMS_KEY_ID automatically selects aws:kms.
# S3_SERVER_SIDE_ENCRYPTION=
# S3_KMS_KEY_ID=
# S3_SIGNED_URL_TTL_SECONDS=300
# CDN_BASE_URL=https://media.example.com
# CDN_KEY_PAIR_ID=
# CDN_PRIVATE_KEY_PATH=./secrets/cloudfront-private-key.pem
# CSP origins allowed to render signed images/audio/video (origins, not paths).
# MEDIA_ORIGINS=https://media.example.com

# Malware scanning. Set CLAMAV_REQUIRED=true in production to fail closed.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_REQUIRED=true
# CLAMAV_TIMEOUT_MS=20000

# ------------------------------------------------------------- first-run admin
# Used only when the account does not already exist.
SEED_ADMIN_EMAIL=office@intesho.com
SEED_ADMIN_USERNAME=admin
# If left empty a random password is generated and printed once at startup.
SEED_ADMIN_PASSWORD=

# --------------------------------------------------------------------- WebRTC
# STUN is enough on most networks. A TURN server is needed for participants
# behind symmetric NAT / restrictive corporate firewalls.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=
# Preferred in production: coturn REST-style, time-limited HMAC credentials.
# TURN_SHARED_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3600

# SFU for large rooms. When configured, clients use LiveKit instead of mesh.
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_URL=https://livekit.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_MAX_PARTICIPANTS=500
# LIVEKIT_REGIONS=tehran|wss://ir-media.example.com|https://ir-api.example.com,frankfurt|wss://eu-media.example.com|https://eu-api.example.com
# LIVEKIT_EGRESS_ENABLED=false
# CALL_TRANSCRIPT_WEBHOOK_SECRET=
# CALL_TRANSCRIPT_WEBHOOK_SECRET_FILE=

# ---------------------------------------------------------- background jobs
# Bounded defaults keep small servers responsive under media/job bursts.
# JOB_CONCURRENCY=4
# MEDIA_CONCURRENCY=2
# POSTGRES_POOL_MAX=8
# NODE_OPTIONS=--max-old-space-size=384
# WORKER_METRICS_PORT=9464

# Email and Web Push delivery for queued notifications.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=youtBeLimo <no-reply@example.com>
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ----------------------------------------------------------- observability
# METRICS_TOKEN=set-a-long-random-bearer-token
# METRICS_TOKEN_FILE=/run/secrets/metrics_token
# OTEL_SERVICE_NAME=youtbelimo
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --------------------------------------------------------------- backups
# BACKUP_DIR=./server/data/backups
# BACKUP_RETENTION_DAYS=30
