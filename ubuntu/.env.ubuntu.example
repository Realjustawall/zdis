NODE_ENV=production
DATABASE_DRIVER=sqlite
DATA_DIR=./server/data
SQLITE_FILE=./server/data/zdis.sqlite3
SQLITE_STATEMENT_CACHE=128
STORAGE_DRIVER=local
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://localhost:8080
CLIENT_ORIGIN=http://localhost:8080
SECURE_COOKIES=false
TRUST_PROXY=false
REDIS_URL=
REQUIRE_REDIS=false
REQUIRE_POSTGRES=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Set these for server-enforced channel and private-call media permissions.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
