# Paths are relative to the project root. Keep data on a local NTFS disk.
NODE_ENV=production
DATABASE_DRIVER=sqlite
DATA_DIR=./server/data
SQLITE_FILE=./server/data/zdis.sqlite3
SQLITE_STATEMENT_CACHE=128
STORAGE_DRIVER=local
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=http://localhost:8080
CLIENT_ORIGIN=http://localhost:8080
# Set true when serving through an HTTPS reverse proxy.
SECURE_COOKIES=false
TRUST_PROXY=false
REDIS_URL=
REQUIRE_REDIS=false
REQUIRE_POSTGRES=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
# Blank generates an admin password, printed once at first startup.
SEED_ADMIN_PASSWORD=
